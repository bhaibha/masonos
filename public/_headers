# The service worker must never be served from cache, or a deploy can't ever
# replace it and users stay pinned to an old shell.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Vite writes content-hashed filenames here, so these are safe to pin.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The icons and the logo live at fixed, unhashed paths — the service worker
# pre-caches them by name and a hashed URL could not be listed there. An hour
# is short enough that replacing the artwork actually reaches people, and long
# enough that the login screen doesn't refetch the mark on every visit.
/icon-192.png
  Cache-Control: public, max-age=3600
/icon-512.png
  Cache-Control: public, max-age=3600
/icon-maskable-512.png
  Cache-Control: public, max-age=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=3600
/favicon-32.png
  Cache-Control: public, max-age=3600
/favicon.ico
  Cache-Control: public, max-age=3600
/logo-full.png
  Cache-Control: public, max-age=3600
/logo-mark.png
  Cache-Control: public, max-age=3600
