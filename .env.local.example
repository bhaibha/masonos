# Copy to .env.local and fill in. Never commit .env.local (gitignored via *.local).
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web push (migration 036). Generate a pair with:  npx web-push generate-vapid-keys
# Only the PUBLIC half belongs here — it ships in the bundle by design.
# The private half is a secret on the daily-task-push Edge Function, nowhere else.
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
